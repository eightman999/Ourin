  {
   "category": "ghost_changed",
   "id": "ghost_changed_004",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "<<R0>>と入れ替わりでやってきたよ！桜の花びらも一緒にお引っ越しだね！"
