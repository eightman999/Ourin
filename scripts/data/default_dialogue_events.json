  {
   "category": "ghost_changed",
   "id": "ghost_changed_003",
   "lines": [
    {
     "who": 2,
     "face": 10,
     "text": "ちりん、<<R0>>、おつかれさま。"
    },
    {
     "who": 0,
     "face": 0,
     "text": "<<R0>>、帰りに手を振ってくれたよ！さあ、ここからはわたしたちの番だね！"
