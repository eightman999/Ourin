  },
  {
   "category": "battery_low",
   "id": "battery_low_001",
   "lines": [
    {
     "who": 0,
     "face": 4,
     "text": "あっ、きみ大変だよ！バッテリーが残り<<R0>>パーセントになってるよ！"
