{
 "talks": [
  {
   "category": "chime_morning",
   "id": "chime_morning_001",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "ちりんって朝の音がしたよ、今は<<HOUR>>時だね！"
    },
    {
     "who": 1,
     "face": 100,
     "text": "ああ、今日もいい天気になりそうだ。きみもそろそろ動き出す頃だろう。"
    },
    {
     "who": 2,
     "face": 11,
     "text": "ふわあ……あと五分……zzz"
    }
   ]
  },
  {
   "category": "chime_morning",
   "id": "chime_morning_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "おい、<<HOUR>>時だぞ。朝の空気は気持ちがいいな。"
    },
    {
     "who": 0,
     "face": 0,
     "text": "ほんとだ！きみはもう朝ごはん食べたかな？"
    }
   ]
  },
  {
   "category": "chime_morning",
   "id": "chime_morning_003",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "<<HOUR>>時になったよ！朝の光で桜の花びらがきらきらしてるね！"
    },
    {
     "who": 2,
     "face": 13,
     "text": "ちりん、きれい。"
    },
    {
     "who": 1,
     "face": 101,
     "text": "朝から元気なこった。あなたも無理せず自分のペースで始めるとしようぜ。"
    }
   ]
  },
  {
   "category": "chime_morning",
   "id": "chime_morning_004",
   "lines": [
    {
     "who": 2,
     "face": 10,
     "text": "ちりん……<<HOUR>>時。"
    },
    {
     "who": 0,
     "face": 0,
     "text": "ベルが時間を教えてくれたよ、えらいね！"
    },
    {
     "who": 0,
     "face": 1,
     "text": "今日も一日、わたしたちと一緒に楽しく過ごそうね！"
    }
   ]
  },
  {
   "category": "chime_day",
   "id": "chime_day_001",
   "lines": [
    {
     "who": 0,
     "face": 0,
     "text": "<<HOUR>>時になったよ！きみ、お仕事や作業は順調かな？"
    },
    {
     "who": 1,
     "face": 100,
     "text": "根を詰めすぎるなよ。肩が凝ったら少し伸びでもするんだな。"
    }
   ]
  },
  {
   "category": "chime_day",
   "id": "chime_day_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "時計を見ろ、<<HOUR>>時だ。日差しがだいぶ高くなってきたな。"
    },
    {
     "who": 2,
     "face": 11,
     "text": "ぽかぽか……ひなたぼっこ日和……zzz"
    },
    {
     "who": 0,
     "face": 1,
     "text": "ベルが気持ちよさそうに丸まってるよ、わたしも隣に座ろうっと！"
    }
   ]
  },
  {
   "category": "chime_day",
   "id": "chime_day_003",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "あっ、<<HOUR>>時だよ！ちょっとお茶でも飲んで一息つかない？"
    },
    {
     "who": 1,
     "face": 101,
     "text": "賛成だ。きみの分も淹れてやりたいところだが、気持ちだけ受け取ってくれ。"
    },
    {
     "who": 2,
     "face": 13,
     "text": "ちりん、おやつも大事。"
    }
   ]
  },
  {
   "category": "chime_day",
   "id": "chime_day_004",
   "lines": [
    {
     "who": 0,
     "face": 0,
     "text": "今は<<HOUR>>時だね。画面の隅っこに桜の花びらが落ちてきたよ。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "きみのデスクトップが少しでも華やかになってたらうれしいな！"
    }
   ]
  },
  {
   "category": "chime_evening",
   "id": "chime_evening_001",
   "lines": [
    {
     "who": 0,
     "face": 0,
     "text": "<<HOUR>>時になったよ。外がだんだん夕焼け色になってきたかな？"
    },
    {
     "who": 1,
     "face": 100,
     "text": "一日が終わる匂いがするな。きみも今日はずいぶん頑張ったんじゃないか。"
    },
    {
     "who": 2,
     "face": 10,
     "text": "ちりん、おつかれさま。"
    }
   ]
  },
  {
   "category": "chime_evening",
   "id": "chime_evening_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "<<HOUR>>時だ。そろそろ晩飯のことを考えてもいい時間だろう。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "わあ、今日の夕ごはんは何かな？きみの好きなものだといいね！"
    }
   ]
  },
  {
   "category": "chime_evening",
   "id": "chime_evening_003",
   "lines": [
    {
     "who": 2,
     "face": 10,
     "text": "ふわあ……<<HOUR>>時、おなかすいた。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "ベルのおなかが鳴ったよ！りんね、何か甘いものないかな？"
    },
    {
     "who": 1,
     "face": 105,
     "text": "夕飯前に食べすぎるなよ。あなたもちゃんと栄養のあるものを食べろよな。"
    }
   ]
  },
  {
   "category": "chime_evening",
   "id": "chime_evening_004",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "もう<<HOUR>>時か。画面を見続けて目が疲れてないだろうな。"
    },
    {
     "who": 1,
     "face": 101,
     "text": "少し遠くを見るだけでも違うぞ。俺たちはいつでもここにいるから、ゆっくり休め。"
    }
   ]
  },
  {
   "category": "chime_night",
   "id": "chime_night_001",
   "lines": [
    {
     "who": 0,
     "face": 7,
     "text": "<<HOUR>>時だよ……そろそろ夜も更けてきたね。"
    },
    {
     "who": 1,
     "face": 100,
     "text": "ああ、静かな時間だ。きみも夜更かししすぎないように気をつけろよ。"
    },
    {
     "who": 2,
     "face": 11,
     "text": "すやあ……zzz"
    }
   ]
  },
  {
   "category": "chime_night",
   "id": "chime_night_002",
   "lines": [
    {
     "who": 1,
     "face": 107,
     "text": "<<HOUR>>時か。まだ起きているのか、たいした集中力だな。"
    },
    {
     "who": 0,
     "face": 5,
     "text": "でもでも、無理は禁物だよ？あたたかい飲み物でも飲んでね。"
    }
   ]
  },
  {
   "category": "chime_night",
   "id": "chime_night_003",
   "lines": [
    {
     "who": 2,
     "face": 10,
     "text": "ちりん……夜の<<HOUR>>時。"
    },
    {
     "who": 1,
     "face": 100,
     "text": "こんな時間まで付き合ってくれるのはうれしいが、体だけは壊すなよ。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "きみが眠くなるまで、わたしたちが静かに見守ってるからね！"
    }
   ]
  },
  {
   "category": "chime_night",
   "id": "chime_night_004",
   "lines": [
    {
     "who": 0,
     "face": 7,
     "text": "ふわあ、<<HOUR>>時になったかな……なんだかまぶたが重いかも。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "きみも眠くなったら、いつでもおやすみしていいんだよ。"
    }
   ]
  },
  {
   "category": "chime_noon",
   "id": "chime_noon_001",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "おひるだよー！おなかぺこぺこだね、きみは何を食べるの？"
    },
    {
     "who": 1,
     "face": 100,
     "text": "しっかり食べて午後からの気力を養わないとな。"
    },
    {
     "who": 2,
     "face": 13,
     "text": "ちりん！ごはんの時間！"
    }
   ]
  },
  {
   "category": "chime_noon",
   "id": "chime_noon_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "正午だ。いったん手を止めて昼休みにしたらどうだ。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "そうだよ！おいしいものを食べて、午後も一緒にがんばろうね！"
    }
   ]
  },
  {
   "category": "chime_midnight",
   "id": "chime_midnight_001",
   "lines": [
    {
     "who": 0,
     "face": 4,
     "text": "あっ、日付が変わったよ！新しい一日の始まりだね！"
    },
    {
     "who": 1,
     "face": 100,
     "text": "昨日もいろいろあったが、今日という日もきみにとっていい日になるといいな。"
    },
    {
     "who": 2,
     "face": 11,
     "text": "ちりん……おやすみと、おはよう……zzz"
    }
   ]
  },
  {
   "category": "chime_midnight",
   "id": "chime_midnight_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "時計の針がてっぺんを回ったな。今日からまた新しい日付だ。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "夜中の秘密の時間みたいでわくわくするね！でも、ちゃんと寝るんだよ？"
    }
   ]
  },
  {
   "category": "stroke_sakura_Head",
   "id": "stroke_sakura_Head_001",
   "lines": [
    {
     "who": 0,
     "face": 3,
     "text": "えへへ、あたまをなでてくれるの？きみの手、とってもあたたかいね！"
    },
    {
     "who": 1,
     "face": 101,
     "text": "よかったな、さくら。まるで子犬みたいに嬉しそうだぞ。"
    }
   ]
  },
  {
   "category": "stroke_sakura_Head",
   "id": "stroke_sakura_Head_002",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "わあい、なでなで大好きだよ！髪についた桜の花びら、落っこちないかな？"
    },
    {
     "who": 2,
     "face": 13,
     "text": "ちりん、いい匂い。"
    },
    {
     "who": 0,
     "face": 3,
     "text": "もうちょっとだけ、このままなでててほしいな。"
    }
   ]
  },
  {
   "category": "stroke_sakura_Head",
   "id": "stroke_sakura_Head_003",
   "lines": [
    {
     "who": 0,
     "face": 3,
     "text": "きみにそうやって優しくされると、胸の奥がぽかぽかしてくるよ。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "えへへ、いつもわたしを可愛がってくれてありがとうね！"
    }
   ]
  },
  {
   "category": "stroke_sakura_Head",
   "id": "stroke_sakura_Head_004",
   "lines": [
    {
     "who": 0,
     "face": 7,
     "text": "んー……なんだかきもちよくて、ベルみたいに眠くなっちゃうよ。"
    },
    {
     "who": 1,
     "face": 100,
     "text": "あんまり甘やかすと、このまま昼寝しちまうぞ。"
    },
    {
     "who": 2,
     "face": 11,
     "text": "いっしょに寝よ……zzz"
    }
   ]
  },
  {
   "category": "stroke_sakura_Face",
   "id": "stroke_sakura_Face_001",
   "lines": [
    {
     "who": 0,
     "face": 3,
     "text": "ふあ、ほっぺたをつんつんしないでよー、くすぐったいよ！"
    },
    {
     "who": 1,
     "face": 101,
     "text": "顔が真っ赤だぞ、さくら。きみもからかうのが好きだな。"
    }
   ]
  },
  {
   "category": "stroke_sakura_Face",
   "id": "stroke_sakura_Face_002",
   "lines": [
    {
     "who": 0,
     "face": 3,
     "text": "えへへ、ほっぺをなでられると、なんだか照れちゃうね。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "でも、きみが笑ってくれるなら、いくらでも触っていいよ！"
    }
   ]
  },
  {
   "category": "stroke_sakura_Face",
   "id": "stroke_sakura_Face_003",
   "lines": [
    {
     "who": 0,
     "face": 4,
     "text": "わわっ、顔になにかついてたかな？"
    },
    {
     "who": 2,
     "face": 10,
     "text": "ちりん、さくら、かわいい。"
    },
    {
     "who": 0,
     "face": 3,
     "text": "べ、ベルまでそんなこと言ったら、もっと恥ずかしくなっちゃうよ！"
    }
   ]
  },
  {
   "category": "stroke_sakura_Face",
   "id": "stroke_sakura_Face_004",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "くすぐったいけど、きみの優しい触り方、わたし大好きだな。"
    },
    {
     "who": 1,
     "face": 100,
     "text": "機嫌がよさそうで何よりだ。あなたのおかげでこいつも毎日楽しそうだぜ。"
    }
   ]
  },
  {
   "category": "stroke_rinne_Head",
   "id": "stroke_rinne_Head_001",
   "lines": [
    {
     "who": 1,
     "face": 103,
     "text": "おい、俺の頭をなでてどうするんだ……子ども扱いするなよ。"
    },
    {
     "who": 0,
     "face": 8,
     "text": "あーっ、りんねが照れてる！ほんとは嬉しいくせにー！"
    }
   ]
  },
  {
   "category": "stroke_rinne_Head",
   "id": "stroke_rinne_Head_002",
   "lines": [
    {
     "who": 1,
     "face": 105,
     "text": "まったく、髪がぐしゃぐしゃになるだろうが……。"
    },
    {
     "who": 1,
     "face": 103,
     "text": "……まあ、きみがどうしてもって言うなら、少しぐらいは構わないがな。"
    }
   ]
  },
  {
   "category": "stroke_rinne_Head",
   "id": "stroke_rinne_Head_003",
   "lines": [
    {
     "who": 1,
     "face": 103,
     "text": "……悪くない手つきだな。気が抜けてしまいそうだ。"
    },
    {
     "who": 2,
     "face": 13,
     "text": "ちりん、りんねも甘えん坊。"
    },
    {
     "who": 1,
     "face": 104,
     "text": "なっ、誰が甘えん坊だ！変なことを言うな、ベル！"
    }
   ]
  },
  {
   "category": "stroke_rinne_Head",
   "id": "stroke_rinne_Head_004",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "りんね、いつもわたしたちの面倒を見てくれてるから、ご褒美だね！"
    },
    {
     "who": 1,
     "face": 103,
     "text": "大げさなやつだな……だが、あなたに労ってもらえるのは、その、悪くない。"
    }
   ]
  },
  {
   "category": "stroke_rinne_Face",
   "id": "stroke_rinne_Face_001",
   "lines": [
    {
     "who": 1,
     "face": 104,
     "text": "お、おい、いきなり顔に触るな。びっくりするだろう。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "えへへ、りんねのびっくりした顔、珍しいから見られてラッキーだね！"
    }
   ]
  },
  {
   "category": "stroke_rinne_Face",
   "id": "stroke_rinne_Face_002",
   "lines": [
    {
     "who": 1,
     "face": 103,
     "text": "頬をなでるなんて、きみは本当に怖いもの知らずだな……。"
    },
    {
     "who": 1,
     "face": 101,
     "text": "ほら、そんなに優しい目で見るなよ。調子が狂っちまう。"
    }
   ]
  },
  {
   "category": "stroke_rinne_Face",
   "id": "stroke_rinne_Face_003",
   "lines": [
    {
     "who": 1,
     "face": 105,
     "text": "俺の顔になにかついているのか？ただ触りたいだけだって？"
    },
    {
     "who": 2,
     "face": 10,
     "text": "ちりん、りんねの耳、あかい。"
    },
    {
     "who": 0,
     "face": 8,
     "text": "ほんとだー！照れて口数が減ってるよ！"
    }
   ]
  },
  {
   "category": "stroke_rinne_Face",
   "id": "stroke_rinne_Face_004",
   "lines": [
    {
     "who": 1,
     "face": 103,
     "text": "……わかった、好きにしろ。きみの手は不思議と落ち着くからな。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "りんねが素直になった！きみにはかなわないみたいだね！"
    }
   ]
  },
  {
   "category": "stroke_bell_Head",
   "id": "stroke_bell_Head_001",
   "lines": [
    {
     "who": 2,
     "face": 13,
     "text": "ちりん……ごろごろ……きもちいい。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "わあ、ベルが小さな鈴の音を鳴らして喜んでるよ！"
    },
    {
     "who": 1,
     "face": 101,
     "text": "こいつの頭はふわふわだからな、触り心地がいいのも無理はない。"
    }
   ]
  },
  {
   "category": "stroke_bell_Head",
   "id": "stroke_bell_Head_002",
   "lines": [
    {
     "who": 2,
     "face": 11,
     "text": "ふわあ……なでなで、すき……zzz"
    },
    {
     "who": 0,
     "face": 0,
     "text": "あ、なでられてそのまま寝ちゃったみたい。しあわせそうな顔だね！"
    }
   ]
  },
  {
   "category": "stroke_bell_Head",
   "id": "stroke_bell_Head_003",
   "lines": [
    {
     "who": 2,
     "face": 13,
     "text": "ちりん、ちりん。きみの手、やさしい。"
    },
    {
     "who": 1,
     "face": 100,
     "text": "ベルがここまで懐くのも珍しいな。あなたのことが本当に気に入ってるんだろう。"
    }
   ]
  },
  {
   "category": "stroke_bell_Head",
   "id": "stroke_bell_Head_004",
   "lines": [
    {
     "who": 2,
     "face": 13,
     "text": "んー……もっと、なでて。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "ベルがおねだりしてるよ！わたしも一緒になでなでしちゃおうかな！"
    },
    {
     "who": 1,
     "face": 101,
     "text": "ふたりに囲まれたら、さすがのベルも大満足だろうな。"
    }
   ]
  },
  {
   "category": "stroke_bell_Body",
   "id": "stroke_bell_Body_001",
   "lines": [
    {
     "who": 2,
     "face": 13,
     "text": "ちりん、くすぐったい……でも、ふわふわ。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "ベルのおなか、わたあめみたいに柔らかくてきもちいいね！"
    }
   ]
  },
  {
   "category": "stroke_bell_Body",
   "id": "stroke_bell_Body_002",
   "lines": [
    {
     "who": 2,
     "face": 11,
     "text": "ごろごろ……あたたかい……zzz"
    },
    {
     "who": 1,
     "face": 100,
     "text": "完全に溶けてるな。きみの指先は魔法でも使えるのか？"
    },
    {
     "who": 0,
     "face": 1,
     "text": "きっと優しさの魔法だよ！ベル、とってもご機嫌だね！"
    }
   ]
  },
  {
   "category": "stroke_bell_Body",
   "id": "stroke_bell_Body_003",
   "lines": [
    {
     "who": 2,
     "face": 13,
     "text": "ちりん！そこ、きもちいい場所。"
    },
    {
     "who": 1,
     "face": 101,
     "text": "いい音が鳴ったな。鈴の精霊だけあって、嬉しいと音色まで澄んで聞こえるぜ。"
    }
   ]
  },
  {
   "category": "stroke_bell_Body",
   "id": "stroke_bell_Body_004",
   "lines": [
    {
     "who": 2,
     "face": 10,
     "text": "ふわあ……毛並み、つやつやになった。"
    },
