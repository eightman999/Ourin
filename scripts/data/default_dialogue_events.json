    {
     "who": 0,
     "face": 5,
     "text": "間に合いますようにーっ！"
    }
   ]
  },
  {
   "category": "battery_critical",
   "id": "battery_critical_004",
   "lines": [
    {
     "who": 0,
     "face": 4,
     "text": "きゃあ、残りが<<R0>>パーセントだよ！画面が眠りそうになってるよ！"
