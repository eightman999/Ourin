   "id": "ghost_calling_001",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "<<R0>>を呼ぶんだね！おーい、こっちだよー！"
    },
    {
     "who": 1,
     "face": 100,
     "text": "大声を出さなくてもすぐ来るさ。にぎやかになりそうだな。"
    },
