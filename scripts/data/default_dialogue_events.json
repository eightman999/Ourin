  {
   "category": "ghost_changing",
   "id": "ghost_changing_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "<<R0>>に代わるんだな。また俺たちと話したくなったら、いつでも呼んでくれ。"
    },
