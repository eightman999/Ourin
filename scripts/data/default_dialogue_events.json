   "id": "ghost_changed_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "<<R0>>と交代して戻ってきたぞ。ここから先は俺たちが相手をしよう。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "またきみの画面に来られてうれしいな！何して遊ぶ？"
