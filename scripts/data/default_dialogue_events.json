  {
   "category": "screensaver_start",
   "id": "screensaver_start_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "しばらく席を外しているみたいだな。画面の番は俺たちに任せておけ。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "うんっ、きみが帰ってくるまで、ここでお留守番してるね！"
    }
   ]
  },
  {
   "category": "screensaver_start",
   "id": "screensaver_start_003",
   "lines": [
    {
     "who": 2,
     "face": 11,
     "text": "ちりん……画面、ゆらゆら……zzz"
    },
    {
     "who": 0,
     "face": 7,
     "text": "ほんとだね、見てたらわたしも少し眠くなってきちゃったかも……。"
    }
   ]
  },
  {
   "category": "screensaver_end",
   "id": "screensaver_end_001",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "あっ、きみが戻ってきた！おかえりなさーい！"
