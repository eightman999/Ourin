  {
   "category": "screensaver_end",
   "id": "screensaver_end_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "スクリーンセーバーが解除されたな。おかえり、待っていたぞ。"
    },
    {
     "who": 0,
     "face": 8,
     "text": "ちゃーんと3人でいい子にお留守番してたんだよ！ほめてほめて！"
    }
   ]
  },
  {
   "category": "screensaver_end",
   "id": "screensaver_end_003",
   "lines": [
    {
     "who": 2,
     "face": 10,
     "text": "ふわあ……あ、帰ってきた。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "ベルも目を覚ましたみたい！きみがいると、やっぱり画面が明るくなるね！"
    }
   ]
  },
  {
   "category": "display_change",
   "id": "display_change_001",
   "lines": [
    {
     "who": 0,
     "face": 4,
     "text": "わわっ、なんだかお部屋の広さが急に変わったよ！"
    },
    {
     "who": 1,
     "face": 104,
     "text": "おっと、画面の解像度かモニターの接続を切り替えたんだな。"
    },
    {
     "who": 2,
     "face": 12,
     "text": "ちりん、景色がひろい。"
    }
   ]
  },
  {
   "category": "display_change",
   "id": "display_change_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "ディスプレイの設定が変わったようだな。俺たちの立ち位置はここで問題ないか？"
    },
    {
     "who": 0,
     "face": 1,
     "text": "新しい眺めも新鮮でいいね！きみからわたしたち、ちゃんと見えてるかな？"
    }
   ]
  },
  {
   "category": "display_change",
   "id": "display_change_003",
   "lines": [
    {
     "who": 0,
     "face": 4,
     "text": "きゃっ、画面がぴかっとしてびっくりしたよ！"
    },
    {
     "who": 2,
     "face": 10,
     "text": "ちりん、引っ越しみたい。"
    },
    {
     "who": 1,
     "face": 101,
     "text": "部屋の模様替えみたいなものさ。きみが使いやすい広さが一番だからな。"
    }
   ]
  },
  {
   "category": "file_drop",
   "id": "file_drop_001",
   "lines": [
    {
     "who": 0,
     "face": 4,
     "text": "わあっ、何かをわたしに持たせてくれたよ！これは何かな？"
    },
    {
     "who": 1,
     "face": 100,
     "text": "ファイルを落としたみたいだな。俺たちに預けてどうするつもりだ？"
    },
    {
     "who": 2,
     "face": 10,
     "text": "ちりん、食べものじゃない。"
    }
   ]
  },
  {
   "category": "file_drop",
   "id": "file_drop_002",
   "lines": [
    {
     "who": 1,
     "face": 105,
     "text": "おっと、急に荷物を渡されても困るぞ。特別なファイルじゃないみたいだが。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "きみの大事な宝物を見せてくれたのかな？えへへ、うれしいな！"
    }
   ]
  },
  {
   "category": "file_drop",
   "id": "file_drop_003",
   "lines": [
    {
     "who": 2,
     "face": 12,
     "text": "ちりん！あたまに、のっかった。"
    },
    {
     "who": 0,
     "face": 1,
     "text": "わあ、ベルの頭にファイルが乗っちゃったよ！重くないかな？"
    },
    {
     "who": 1,
     "face": 101,
     "text": "ほら、どかしてやるからじっとしてろ。あなたも妙なところに落とすなよ。"
    }
   ]
  },
  {
   "category": "file_drop",
   "id": "file_drop_004",
   "lines": [
    {
     "who": 0,
     "face": 0,
     "text": "このファイル、わたしたちに見せてくれたの？"
    },
    {
     "who": 0,
     "face": 1,
     "text": "中身はわからないけど、きみが作ったものならきっと素敵なんだろうね！"
    }
   ]
  },
  {
   "category": "shell_changed",
   "id": "shell_changed_001",
   "lines": [
    {
     "who": 0,
     "face": 1,
     "text": "じゃじゃーん！<<R1>>に着替えてみたよ！どうかな、似合ってる？"
    },
    {
     "who": 1,
     "face": 103,
     "text": "……悪くないんじゃないか。俺まで<<R1>>になるとは思わなかったがな。"
    },
    {
     "who": 2,
     "face": 13,
     "text": "ちりん、おしゃれ！"
    }
   ]
  },
  {
   "category": "shell_changed",
   "id": "shell_changed_002",
   "lines": [
    {
     "who": 1,
     "face": 100,
     "text": "<<R1>>に切り替わったな。いつもと雰囲気が変わって新鮮な気分だ。"
    },
    {
     "who": 0,
     "face": 3,
     "text": "えへへ、きみが選んでくれた<<R1>>、とっても気に入っちゃった！"
    }
   ]
  },
  {
   "category": "shell_changed",
   "id": "shell_changed_003",
   "lines": [
    {
     "who": 2,
     "face": 13,
     "text": "ちりん、<<R1>>、ふわふわ。"
    },
    {
