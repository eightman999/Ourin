  },
  {
   "category": "battery_critical",
   "id": "battery_critical_001",
   "lines": [
    {
     "who": 0,
     "face": 4,
     "text": "わわっ、バッテリーがもう<<R0>>パーセントしかないよ！消えちゃうよー！"
