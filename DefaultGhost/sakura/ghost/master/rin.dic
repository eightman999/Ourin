}

// キャラ番号 → 台本名（0 さくら / 1 りんね / 2 ベル。空・不明はさくら）
WhoName
{
	if _argv[0] == 1 {
		"rinne"
	}
	elseif _argv[0] == 2 {
		"bell"
	}
	else {
		"sakura"
	}
}

// 参照値を台本へ埋め込む前に、Sakura Script の注入になる文字（\ と %）を取り除く。
Esc
{
	_s = _argv[0]
	_s = REPLACE(_s, CHR(92), "")
	_s = REPLACE(_s, "%", "")
	_s
}
