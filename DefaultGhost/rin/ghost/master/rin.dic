// Rin: Ourin 標準ゴースト 最小辞書
OnBoot
{
	"\0\s[0]起動したよ。Ourin へようこそ！\n\1\s[10]……よろしく。\e"
}

OnFirstBoot
{
	"\0\s[0]はじめまして、リンです。\1\s[10]ベルだ。\e"
}

OnClose
{
	"\0\s[0]またね。\1\s[10]ああ。\e"
}

OnMouseDoubleClick
{
	"\0\s[1]なあに？\e"
}

OnMouseClick
{
	"\0\s[1]えへへ。\e"
}

OnAiTalk
{
	_talks = IARRAY
	_talks ,= "\0\s[0]いい天気だね。\e"
	_talks ,= "\0\s[0]お茶でも飲もうか。\1\s[10]……ああ。\e"
	_talks ,= "\0\s[1]桜の鈴、聞こえる？\e"
	_talks[RAND(ARRAYSIZE(_talks))]
}

OnSecondChange
{
	// Reference3 = トーク可能フラグ。約90秒に1回ランダムトーク
	if reference[3] == 1 && RAND(90) == 0 {
		OnAiTalk
	}
}
