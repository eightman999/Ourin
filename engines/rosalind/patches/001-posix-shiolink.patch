+namespace Shiorose {
+ public class Shiori {
+  public static readonly Encoding DEFAULT_CHARSET = new UTF8Encoding(false);
+  internal static async Task Main(string[] args, Func<Shiolink.Load, Task<Rosalind>> loadFunc) {
+   Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
+   using (var reader = new EncodingTextReader(Console.OpenStandardInput()) { Encoding = DEFAULT_CHARSET }) {
+    Console.OutputEncoding = DEFAULT_CHARSET;
+    Rosalind rosa = null;
+    try {
+     var first = Shiolink.Protocol.Parse(reader) as Shiolink.Load;
+     if (first == null) throw new FormatException("Expected SHIOLINK load");
+     rosa = await loadFunc(first);
+     while (true) {
+      var command = Shiolink.Protocol.Parse(reader);
+      if (command is Shiolink.Unload) break;
+      if (command is Shiolink.Sync sync) {
+       Console.Write(sync.SyncStr + "\r\n"); Console.Out.Flush();
+       var request = Shiolink.Request.Parse(reader);
+       var response = await rosa.Request(request);
+       Console.Write(response.ToString()); Console.Out.Flush();
+      } else throw new FormatException("Unexpected second SHIOLINK load");
+     }
+    } catch (EndOfStreamException) { }
+    finally { if (rosa != null) rosa.Unload(new Shiolink.Unload()); }
+   }
+  }
+ }
 }
